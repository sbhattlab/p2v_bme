{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Package, tests and the paper's tools (GPU code if CUDA is found)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}",
        "VECME_BUILD_PAPER_TOOLS": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "default",
      "displayName": "CPU only (no CUDA), warnings as errors, as in CI",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "VECME_CUDA": "OFF",
        "CMAKE_C_FLAGS": "-Werror",
        "CMAKE_CXX_FLAGS": "-Werror"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "The prebuilt binary alone: GPU code for compute capability 7.5 to 12.0 and PTX, runtimes linked in",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "75-real;80-real;86-real;89-real;90-real;100-real;120",
        "VECME_STATIC_RUNTIME": "ON",
        "VECME_BUILD_PAPER_TOOLS": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "default",
      "displayName": "CPU only, AddressSanitizer and UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "VECME_CUDA": "OFF",
        "CMAKE_C_FLAGS": "-g -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-g -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
